<Application x:Class="WoodStreamStreamingStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoodStreamStreamingStudio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Strings.ja-JP.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- スタジオダークテーマ カラー定義 -->
            <SolidColorBrush x:Key="BgDarkBrush" Color="#12131A" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1D26" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#282936" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2E3040" />
            <SolidColorBrush x:Key="AccentBrush" Color="#00D2FF" />
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8A4BFF" />
            <SolidColorBrush x:Key="LiveRedBrush" Color="#FF2D55" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9EA7" />

            <!-- コントロール共通スタイル -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo" />
            </Style>

            <!-- ComboBox スタイル -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- ボタンスタイル -->
            <Style x:Key="StudioButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#343648" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- プライマリアクショントグルボタン -->
            <Style x:Key="ActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
                <Setter Property="Background" Value="#1A3348" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
